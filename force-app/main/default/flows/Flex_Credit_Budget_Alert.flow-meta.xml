<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Alerts admins when a single ledger entry exceeds the per-step ceiling. Narrow the grounding scope before reducing model capability; scope is usually the cheapest saving.</description>
    <interviewLabel>Flex Credit Budget Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Flex Credit Budget Alert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>BuilderVersion</name>
        <value><stringValue>68.0</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunched</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Over_Ceiling</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <triggerType>RecordAfterSave</triggerType>
    <object>Flex_Credit_Ledger__c</object>
    <objectType>Flex_Credit_Ledger__c</objectType>
    <label>On Credit Entry Above Ceiling</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>BuilderVersion</name>
        <value><stringValue>68.0</stringValue></value>
    </processMetadataValues>
    <filters>
        <field>Cost_Center__c</field>
        <operator>NotEqualTo</operator>
        <value><stringValue></stringValue></value>
    </filters>
    <filterLogic>and</filterLogic>
    <decisions>
        <name>Over_Ceiling</name>
        <label>Over Ceiling</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnectorLabel>Within Ceiling</defaultConnectorLabel>
        <defaultConnector><targetReference>End</targetReference></defaultConnector>
        <processType>Rule</processType>
        <rules>
            <name>SingleStepCeiling</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Credits__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue><numberValue>1.0</numberValue></rightValue>
            </conditions>
            <label>Single step over 1.0 credit</label>
        </rules>
    </decisions>
    <alerts>
        <name>Notify_Admins</name>
        <label>Notify Admins</label>
        <description>One step consumed more than the per-step ceiling.</description>
        <locationX>400</locationX>
        <locationY>158</locationY>
        <connector><targetReference>End</targetReference></connector>
        <alertFields>Credits__c</alertFields>
        <alertFields>Session_Id__c</alertFields>
        <recipientAddress>agentops@example.com</recipientAddress>
        <recipientType>Admins</recipientType>
        <subject>Flex Credit ceiling exceeded for a single step</subject>
    </alerts>
    <end>
        <locationX>400</locationX>
        <locationY>200</locationY>
    </end>
</Flow>
