<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Agent Action Audit</label>
    <pluralLabel>Agent Action Audits</pluralLabel>
    <description>Every action attempt, successful or not, with the parameters and the error code.</description>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>false</enableActivities>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <visibility>Public</visibility>
        <fields>
          <fullName>Name</fullName>
          <label>Name</label>
          <type>Text</type>
          <length>80</length>
          <required>true</required>
        </fields>
        <fields>
          <fullName>Session_Id__c</fullName>
          <label>Session Id</label>
          <required>true</required>
          <type>Text</type>
            <length>80</length>
        </fields>
        <fields>
          <fullName>Action_Definition__c</fullName>
          <label>Action</label>
          <type>Lookup</type>
            <referenceTo>Action_Definition__c</referenceTo>
        </fields>
        <fields>
          <fullName>Parameters_Json__c</fullName>
          <label>Parameters JSON</label>
          <type>LongTextArea</type>
            <length>4000</length>
            <visibleLines>6</visibleLines>
        </fields>
        <fields>
          <fullName>Result_Json__c</fullName>
          <label>Result JSON</label>
          <type>LongTextArea</type>
            <length>4000</length>
            <visibleLines>6</visibleLines>
        </fields>
        <fields>
          <fullName>Success__c</fullName>
          <label>Success</label>
          <type>Checkbox</type>
            <defaultValue>false</defaultValue>
        </fields>
        <fields>
          <fullName>Error_Code__c</fullName>
          <label>Error Code</label>
          <type>Text</type>
            <length>80</length>
        </fields>
        <fields>
          <fullName>Duration_Ms__c</fullName>
          <label>Duration (ms)</label>
          <type>Number</type>
            <precision>12</precision>
            <scale>0</scale>
        </fields>
        <fields>
          <fullName>Created_By_Agent__c</fullName>
          <label>Created By Agent</label>
          <type>Checkbox</type>
            <defaultValue>true</defaultValue>
        </fields>
</CustomObject>
