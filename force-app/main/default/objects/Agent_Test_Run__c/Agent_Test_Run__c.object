<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Agent Test Run</label>
    <pluralLabel>Agent Test Runs</pluralLabel>
    <description>One evaluation case. The failure text states the rule that broke.</description>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>false</enableActivities>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <visibility>Public</visibility>
        <fields>
          <fullName>Name</fullName>
          <label>Name</label>
          <type>Text</type>
          <length>80</length>
          <required>true</required>
        </fields>
        <fields>
          <fullName>Case_Id__c</fullName>
          <label>Case Id</label>
          <required>true</required>
          <type>Text</type>
            <length>40</length>
        </fields>
        <fields>
          <fullName>Category__c</fullName>
          <label>Category</label>
          <type>Picklist</type>
            <valueSet>
              <restricted>true</restricted>
<valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Functional</fullName><default>true</default></value>
                <value><fullName>Regression</fullName><default>false</default></value>
                <value><fullName>Grounding</fullName><default>false</default></value>
                <value><fullName>Routing</fullName><default>false</default></value>
                <value><fullName>Governance</fullName><default>false</default></value>
              </valueSetDefinition>
            </valueSet>
        </fields>
        <fields>
          <fullName>User_Message__c</fullName>
          <label>User Message</label>
          <type>LongTextArea</type>
            <length>32768</length>
            <visibleLines>6</visibleLines>
        </fields>
        <fields>
          <fullName>Answer__c</fullName>
          <label>Answer</label>
          <type>LongTextArea</type>
            <length>32768</length>
            <visibleLines>6</visibleLines>
        </fields>
        <fields>
          <fullName>Passed__c</fullName>
          <label>Passed</label>
          <type>Checkbox</type>
            <defaultValue>false</defaultValue>
        </fields>
        <fields>
          <fullName>Failures__c</fullName>
          <label>Failures</label>
          <type>LongTextArea</type>
            <length>4000</length>
            <visibleLines>6</visibleLines>
        </fields>
        <fields>
          <fullName>Credits_Used__c</fullName>
          <label>Credits Used</label>
          <type>Number</type>
            <precision>12</precision>
            <scale>4</scale>
        </fields>
        <fields>
          <fullName>Run_On__c</fullName>
          <label>Run On</label>
          <type>DateTime</type>
        </fields>
</CustomObject>
