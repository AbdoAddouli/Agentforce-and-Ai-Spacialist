<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Agent Definition</label>
    <pluralLabel>Agent Definitions</pluralLabel>
    <description>Versioned agent configuration. One record per agent, per release.</description>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>false</enableActivities>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <visibility>Public</visibility>
        <fields>
          <fullName>Name</fullName>
          <label>Name</label>
          <type>Text</type>
          <length>80</length>
          <required>true</required>
        </fields>
        <fields>
          <fullName>Agent_Key__c</fullName>
          <label>Agent Key</label>
          <required>true</required>
          <type>Text</type>
            <length>80</length>
        </fields>
        <fields>
          <fullName>Instructions__c</fullName>
          <label>Instructions</label>
          <type>LongTextArea</type>
            <length>32768</length>
            <visibleLines>6</visibleLines>
        </fields>
        <fields>
          <fullName>Status__c</fullName>
          <label>Status</label>
          <type>Picklist</type>
            <valueSet>
              <restricted>true</restricted>
<valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Draft</fullName><default>true</default></value>
                <value><fullName>In Review</fullName><default>false</default></value>
                <value><fullName>Active</fullName><default>false</default></value>
                <value><fullName>Retired</fullName><default>false</default></value>
              </valueSetDefinition>
            </valueSet>
        </fields>
        <fields>
          <fullName>Version__c</fullName>
          <label>Version</label>
          <type>Number</type>
            <precision>4</precision>
            <scale>0</scale>
            <defaultValue>1</defaultValue>
        </fields>
        <fields>
          <fullName>Business_Owner__c</fullName>
          <label>Business Owner</label>
          <type>Text</type>
            <length>80</length>
        </fields>
        <fields>
          <fullName>Reviewed_By__c</fullName>
          <label>Reviewed By</label>
          <type>Text</type>
            <length>80</length>
        </fields>
        <fields>
          <fullName>Reviewed_On__c</fullName>
          <label>Reviewed On</label>
          <type>Date</type>
        </fields>
        <fields>
          <fullName>Grounding_Source__c</fullName>
          <label>Grounding Source</label>
          <type>Lookup</type>
            <referenceTo>Grounding_Source__c</referenceTo>
        </fields>
        <fields>
          <fullName>Max_Steps__c</fullName>
          <label>Max Steps</label>
          <type>Number</type>
            <precision>3</precision>
            <scale>0</scale>
            <defaultValue>8</defaultValue>
        </fields>
</CustomObject>
