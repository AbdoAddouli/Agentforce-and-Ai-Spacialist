<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Action Definition</label>
    <pluralLabel>Action Definitions</pluralLabel>
    <description>A capability the agent is permitted to call, with its input and output contract.</description>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>false</enableActivities>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <visibility>Public</visibility>
        <fields>
          <fullName>Name</fullName>
          <label>Name</label>
          <type>Text</type>
          <length>80</length>
          <required>true</required>
        </fields>
        <fields>
          <fullName>Action_Key__c</fullName>
          <label>Action Key</label>
          <required>true</required>
          <type>Text</type>
            <length>80</length>
        </fields>
        <fields>
          <fullName>Agent_Definition__c</fullName>
          <label>Agent</label>
          <type>Lookup</type>
            <referenceTo>Agent_Definition__c</referenceTo>
        </fields>
        <fields>
          <fullName>Input_Schema__c</fullName>
          <label>Input Schema</label>
          <type>LongTextArea</type>
            <length>4000</length>
            <visibleLines>6</visibleLines>
        </fields>
        <fields>
          <fullName>Output_Schema__c</fullName>
          <label>Output Schema</label>
          <type>LongTextArea</type>
            <length>4000</length>
            <visibleLines>6</visibleLines>
        </fields>
        <fields>
          <fullName>Is_Active__c</fullName>
          <label>Active</label>
          <type>Checkbox</type>
            <defaultValue>true</defaultValue>
        </fields>
        <fields>
          <fullName>Requires_Approval__c</fullName>
          <label>Requires Approval</label>
          <type>Checkbox</type>
            <defaultValue>false</defaultValue>
        </fields>
        <fields>
          <fullName>Handler__c</fullName>
          <label>Handler</label>
          <type>Text</type>
            <length>80</length>
        </fields>
</CustomObject>
