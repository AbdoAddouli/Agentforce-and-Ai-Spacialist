<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Flex Credit Ledger</label>
    <pluralLabel>Flex Credit Ledger Entries</pluralLabel>
    <description>Per-step consumption, aggregated by cost center for budget alerts.</description>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>false</enableActivities>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <visibility>Public</visibility>
        <fields>
          <fullName>Name</fullName>
          <label>Name</label>
          <type>Text</type>
          <length>80</length>
          <required>true</required>
        </fields>
        <fields>
          <fullName>Session_Id__c</fullName>
          <label>Session Id</label>
          <required>true</required>
          <type>Text</type>
            <length>80</length>
        </fields>
        <fields>
          <fullName>Agent_Definition__c</fullName>
          <label>Agent</label>
          <type>Lookup</type>
            <referenceTo>Agent_Definition__c</referenceTo>
        </fields>
        <fields>
          <fullName>Step_Type__c</fullName>
          <label>Step Type</label>
          <type>Text</type>
            <length>40</length>
        </fields>
        <fields>
          <fullName>Credits__c</fullName>
          <label>Credits</label>
          <type>Number</type>
            <precision>12</precision>
            <scale>4</scale>
        </fields>
        <fields>
          <fullName>Recorded_On__c</fullName>
          <label>Recorded On</label>
          <type>DateTime</type>
        </fields>
        <fields>
          <fullName>Cost_Center__c</fullName>
          <label>Cost Center</label>
          <type>Text</type>
            <length>80</length>
        </fields>
</CustomObject>
