<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Agent Interaction Log</label>
    <pluralLabel>Agent Interaction Logs</pluralLabel>
    <description>One record per conversation turn, whatever the outcome.</description>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>false</enableActivities>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <visibility>Public</visibility>
        <fields>
          <fullName>Name</fullName>
          <label>Name</label>
          <type>Text</type>
          <length>80</length>
          <required>true</required>
        </fields>
        <fields>
          <fullName>Session_Id__c</fullName>
          <label>Session Id</label>
          <required>true</required>
          <type>Text</type>
            <length>80</length>
        </fields>
        <fields>
          <fullName>Agent_Definition__c</fullName>
          <label>Agent</label>
          <type>Lookup</type>
            <referenceTo>Agent_Definition__c</referenceTo>
        </fields>
        <fields>
          <fullName>Turn_Number__c</fullName>
          <label>Turn Number</label>
          <type>Number</type>
            <precision>5</precision>
            <scale>0</scale>
        </fields>
        <fields>
          <fullName>User_Message__c</fullName>
          <label>User Message</label>
          <type>LongTextArea</type>
            <length>32768</length>
            <visibleLines>6</visibleLines>
        </fields>
        <fields>
          <fullName>Agent_Response__c</fullName>
          <label>Agent Response</label>
          <type>LongTextArea</type>
            <length>32768</length>
            <visibleLines>6</visibleLines>
        </fields>
        <fields>
          <fullName>Outcome__c</fullName>
          <label>Outcome</label>
          <type>Picklist</type>
            <valueSet>
              <restricted>true</restricted>
<valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Answered</fullName><default>true</default></value>
                <value><fullName>Refused</fullName><default>false</default></value>
                <value><fullName>Escalated</fullName><default>false</default></value>
                <value><fullName>Failed</fullName><default>false</default></value>
              </valueSetDefinition>
            </valueSet>
        </fields>
        <fields>
          <fullName>Credits_Used__c</fullName>
          <label>Credits Used</label>
          <type>Number</type>
            <precision>12</precision>
            <scale>4</scale>
        </fields>
</CustomObject>
