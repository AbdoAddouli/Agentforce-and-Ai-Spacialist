    <field>Action_Definition__c</field>
    <label>Refund Request Approval</label>
    <processType>Custom</processType>
    <showSubmitter>false</showSubmitter>
    <stepActions>
        <step>
            <name>Finance Approval</name>
            <label>Finance Approval</label>
            <nextSteps>
                <nextStep>1</nextStep>
            </nextSteps>
        </step>
    </stepActions>
    <activeVersion>1</activeVersion>
    <emailTemplate>Refund_Request_Notification</emailTemplate>
</ApprovalProcess>
