<?xml version="1.0" encoding="UTF-8"?>
<EmailTemplate xmlns="http://soap.sforce.com/2006/04/metadata">
    <available>true</available>
    <body>Flex Credit consumption has exceeded the budget for this cost center.<br/><br/>Cost center: {!Flex_Credit_Ledger__c.Cost_Center__c}<br/>Consumption: {!Flex_Credit_Ledger__c.Credits__c}<br/><br/>Narrow the grounding scope before reducing model capability. Scope is usually the cheapest saving.</body>
    <description>Flex Credit consumption has exceeded the budget for this cost center.Cost center: {!Flex_C</description>
    <name>Flex_Credit_Budget_Alert</name>
    <subject>Flex Credit budget alert for cost center {!Flex_Credit_Ledger__c.Cost_Center__c}</subject>
    <type>custom</type>
</EmailTemplate>
